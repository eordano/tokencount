{
  "name": "tokencount",
  "version": "1.0.1",
  "private": true,
  "description": "Side-by-side text diff with token counts across 9 LLM tokenizers",
  "bin": {
    "tokencount": "npm/bin/tokencount.cjs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:offline": "node scripts/build-offline.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "build:npm": "node scripts/build-npm-packages.mjs",
    "check:versions": "node scripts/build-npm-packages.mjs --check",
    "test:cli": "node tests/cli.test.mjs",
    "test:launcher": "node npm/test/launcher.test.cjs",
    "test:bundle": "node scripts/build-offline.mjs && npx playwright test --config playwright.bundle.config.js",
    "check:pins": "node scripts/fetch-models.mjs --verify-pins"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eordano/tokencount.git"
  },
  "homepage": "https://github.com/eordano/tokencount#readme",
  "bugs": {
    "url": "https://github.com/eordano/tokencount/issues"
  },
  "keywords": [
    "tokenizer",
    "tokens",
    "token-count",
    "llm",
    "claude",
    "gpt",
    "gemini",
    "cli"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.27.3",
    "gpt-tokenizer": "^3.4.0"
  }
}
